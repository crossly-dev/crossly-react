{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@crossly/react": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "examples/*/src"
  ]
}
