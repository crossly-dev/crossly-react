{
  "name": "@crossly/react",
  "version": "0.1.0",
  "description": "React components for the Crossly embeddable storefront: catalog grid, buy button, Vault Markets index and mark. Typed props and events, SSR-safe.",
  "license": "MIT",
  "author": "Crossly",
  "homepage": "https://github.com/crossly-dev/crossly-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossly-dev/crossly-react.git"
  },
  "bugs": {
    "url": "https://github.com/crossly-dev/crossly-react/issues"
  },
  "keywords": [
    "crossly",
    "react",
    "storefront",
    "embed",
    "catalog",
    "checkout",
    "web-components",
    "ecommerce"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crossly/embed": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
